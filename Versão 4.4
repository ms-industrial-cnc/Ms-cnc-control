<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"><meta name="theme-color" content="#101c2a"><title>MS CNC Control V4.3</title><style>*{box-sizing:border-box}body{margin:0;background:#0d1724;color:#e7f2fa;font:15px system-ui,-apple-system,sans-serif}header{padding:18px 16px;background:#16283b;border-bottom:1px solid #34506a}h1{font-size:21px;margin:0}small,.muted{color:#9fb8c8}main{max-width:1100px;margin:auto;padding:14px}.panel{background:#192d40;border:1px solid #38546b;border-radius:14px;padding:14px;margin-bottom:13px}h2{font-size:16px;margin:0 0 12px}label{display:block;color:#b8d1e0;font-size:13px;margin:8px 0 4px}input,select{width:100%;background:#0e2030;border:1px solid #527087;border-radius:8px;color:white;padding:11px;font-size:16px}button{border:0;border-radius:9px;padding:12px 15px;background:#3b92b9;color:white;font-size:15px;font-weight:650;cursor:pointer}button:disabled{opacity:.45}button.secondary{background:#365169}button.stop{background:#a64b52}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.actions button{flex:1;min-width:90px}.readouts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:12px}.readouts div{background:#102334;padding:10px;border-radius:8px;font-size:13px}.readouts strong{display:block;font-size:16px;margin-top:3px;color:#a9ecff}#stage{display:block;width:100%;background:#102232;border-radius:10px;touch-action:pan-y}.warn{color:#ffc46b}.ok{color:#8ce1b5}progress{width:100%;height:14px;accent-color:#35c4d7}@media(max-width:650px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel{padding:11px}} .control43{margin-top:15px;background:#13283a;border:1px solid #47647b;border-radius:12px;padding:12px}.control43 input[readonly]{opacity:.85}.control43 strong{font-size:14px}</style></head><body><header><h1>⚙️ MS CNC CONTROL <small>V4.4</small></h1><small>Robô planar 2R · Vista superior industrial · Braços 400 + 400 mm · Simulação sem hardware</small></header><main><section class="panel"><h2>1. Desenhar peça</h2><div class="grid"><div><label>Formato</label><select id="shape"><option value="circle">Círculo</option><option value="rect">Retângulo</option></select></div><div><label>Diâmetro (mm)</label><input id="diam" type="number" min="1" value="200"></div><div><label>Largura (mm)</label><input id="w" type="number" min="1" value="200"></div><div><label>Altura (mm)</label><input id="h" type="number" min="1" value="100"></div><div><label>Centro X (mm)</label><input id="cx" type="number" value="350"></div><div><label>Centro Y (mm)</label><input id="cy" type="number" value="0"></div></div><div class="actions"><button id="draw">Atualizar desenho</button><button id="svg" class="secondary">Exportar SVG</button></div><small>Coordenadas relativas ao eixo da base. O contorno é nominal, sem compensação de kerf.</small></section><section class="panel"><h2>2. Importar DXF do Shapr3D</h2><label>Arquivo DXF (2D)</label><input type="file" id="dxf" accept=".dxf,text/plain,application/dxf"><div class="grid"><div><label>Unidades do DXF</label><select id="units"><option value="auto">Automático</option><option value="1">Milímetros</option><option value="25.4">Polegadas</option><option value="1000">Metros</option></select></div><div><label>Deslocar X (mm)</label><input type="number" id="dx" value="350"></div><div><label>Deslocar Y (mm)</label><input type="number" id="dy" value="0"></div></div><div class="actions"><button id="import">📂 Importar DXF</button><button id="center" class="secondary">Centralizar peça no ponto X/Y</button></div><p id="dxfinfo" class="muted">Aceita LINE, CIRCLE, ARC e LWPOLYLINE (inclusive segmentos curvos com bulge). Apenas geometria 2D.</p></section><section class="panel"><h2>3. Simulação realista · Vista superior</h2><svg id="stage" viewBox="0 0 900 720" role="img" aria-label="Vista superior da trajetória e braços do robô"><defs><pattern id="minor" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" fill="none" stroke="#254458" stroke-width="1"/></pattern></defs><rect width="900" height="720" fill="url(#minor)"/><g id="drawing"></g><g id="cuttrace"></g><g id="arm"><g id="arm1body"><line x1="0" y1="0" x2="288" y2="0" stroke="#050c13" stroke-width="34" stroke-linecap="round" opacity=".5" transform="translate(2 5)"/><line x1="0" y1="0" x2="288" y2="0" stroke="#667889" stroke-width="29" stroke-linecap="round"/><line x1="12" y1="-8" x2="272" y2="-8" stroke="#c5d5df" stroke-width="5" stroke-linecap="round"/><line x1="36" y1="7" x2="253" y2="7" stroke="#253b4d" stroke-width="8" stroke-linecap="round"/></g><g id="arm2body"><line x1="0" y1="0" x2="288" y2="0" stroke="#050c13" stroke-width="29" stroke-linecap="round" opacity=".5" transform="translate(2 5)"/><line x1="0" y1="0" x2="288" y2="0" stroke="#8295a3" stroke-width="24" stroke-linecap="round"/><line x1="12" y1="-7" x2="270" y2="-7" stroke="#d2e1e8" stroke-width="4" stroke-linecap="round"/><line x1="35" y1="6" x2="252" y2="6" stroke="#30485b" stroke-width="7" stroke-linecap="round"/></g><g id="baseassembly"><circle r="35" fill="#080d13" stroke="#738798" stroke-width="3"/><circle r="28" fill="#263541" stroke="#b4c4ce" stroke-width="2"/><circle r="20" fill="#526777" stroke="#18232e" stroke-width="5"/><circle r="10" fill="#d4e3eb"/><g fill="#b5c7d2"><circle cx="0" cy="-26" r="3"/><circle cx="26" cy="0" r="3"/><circle cx="0" cy="26" r="3"/><circle cx="-26" cy="0" r="3"/></g></g><g id="jointassembly"><circle r="23" fill="#172630" stroke="#a7bcc9" stroke-width="3"/><circle r="17" fill="#536a7b" stroke="#d3e0e7" stroke-width="2"/><circle r="8" fill="#e3edf2"/><rect x="-10" y="-24" width="20" height="12" rx="3" fill="#364c5c" stroke="#b9cbd5" stroke-width="1"/></g><g id="torchassembly"><rect x="-11" y="-23" width="22" height="35" rx="5" fill="#263946" stroke="#b8cbd6" stroke-width="2"/><rect x="-6" y="-11" width="12" height="27" rx="3" fill="#8a9aa4"/><path d="M-6 15 L0 24 L6 15Z" fill="#d4a66a"/><circle id="torchglow" cy="24" r="16" fill="#ff8d2b" opacity="0"/><circle id="torch" cy="24" r="4" fill="#e9b874"/></g><g id="sparks"></g></g><g id="labels" font-size="14" fill="#bfd2de"></g></svg><div class="grid"><div><label>Velocidade (mm/min)</label><input id="speed" type="number" value="800" min="10" max="10000"></div><div><label>Configuração do cotovelo</label><select id="elbow"><option value="1">Cotovelo positivo</option><option value="-1">Cotovelo negativo</option></select></div></div><div class="readouts"><div>Tocha plasma<strong id="torchstate">DESLIGADA</strong></div><div>Contorno atual<strong id="contourstate">1 / 1</strong></div></div><section class="control43"><h2>4. Painel dos motores · V4.4</h2><div class="grid"><div><label>Modo de operação</label><select id="operationmode"><option value="simulation">🧪 Simulação</option><option value="real" disabled>🔒 Robô real (indisponível)</option></select></div><div><label>Polia motora</label><input value="20 dentes" readonly></div><div><label>Polia do braço</label><input value="100 dentes" readonly></div></div><div class="readouts"><div>Motor 1 · posição teórica<strong id="motor1">—</strong></div><div>Motor 2 · posição teórica<strong id="motor2">—</strong></div><div>Sensor de referência 1<strong id="sensor1">Não referenciado</strong></div><div>Sensor de referência 2<strong id="sensor2">Não referenciado</strong></div><div>Redução dos eixos<strong>5:1</strong></div><div>Conexão com robô<strong id="connection">Desconectado</strong></div></div><div class="actions"><button id="simulatehome" class="secondary">⌖ Simular referenciamento</button><button id="resetreference" class="secondary">Limpar referência</button></div><p id="homemessage" class="muted">Os sensores são virtuais. Os ângulos dos motores são relativos ao zero matemático das articulações, não ao zero físico da máquina.</p></section><section class="control43"><h2>5. Comunicação local · V4.4</h2><p class="muted">Projeto de comunicação com rede própria MS-CNC-ROBO. Este painel é um protótipo de interface: nenhum dispositivo é procurado, conectado ou comandado.</p><div class="readouts"><div>Wi-Fi do robô<strong id="net44">Não verificado</strong></div><div>Controlador<strong id="ctrl44">Não conectado</strong></div><div>Protocolo<strong>Em projeto</strong></div><div>Segurança física<strong>Não validada</strong></div></div><div class="actions"><button id="diag44" class="secondary">🔍 Diagnóstico da interface</button><button id="job44" class="secondary">📋 Preparar resumo do trabalho</button></div><label>Informações para integração futura</label><div class="grid"><div><label>SSID planejado</label><input value="MS-CNC-ROBO" readonly></div><div><label>IP local sugerido</label><input value="192.168.4.1" readonly></div></div><p id="commmsg44" class="muted" aria-live="polite">Sem comunicação física. O iPad poderá conectar-se à rede do controlador quando o firmware estiver desenvolvido e validado.</p><label>Prévia do trabalho (não executável)</label><textarea id="jobpreview44" rows="6" readonly style="width:100%;background:#0e2030;border:1px solid #527087;border-radius:8px;color:#e7f2fa;padding:10px;font:12px ui-monospace,monospace" placeholder="Toque em Preparar resumo do trabalho"></textarea></section><div class="actions"><button id="start">▶ Iniciar</button><button id="pause" class="secondary">⏸ Pausar</button><button id="stop" class="stop">■ Parar</button><button id="home" class="secondary">↩ Início</button></div><label>Progresso</label><progress id="progress" value="0" max="100"></progress><div class="readouts"><div>Posição X / Y<strong id="pos">—</strong></div><div>Ângulos θ1 / θ2<strong id="angles">—</strong></div><div>Progresso<strong id="pct">0%</strong></div><div>Estado<strong id="state">Pronto</strong></div></div><p id="message" class="muted">Selecione a peça e toque em Iniciar.</p></section><section class="panel"><h2>Segurança e limitações</h2><p class="muted">DXF 2D: entidades LINE, CIRCLE, ARC, LWPOLYLINE, POLYLINE e VERTEX simples. SPLINE, INSERT/blocos e ELLIPSE não são convertidos. Trajetos abertos não são fechados automaticamente. Movimentos entre contornos são deslocamentos simulados com tocha desligada. Não há compensação de kerf, limites mecânicos, aceleração, colisão ou G-code. Acionamento da tocha é exclusivamente visual, sem saída elétrica. Efeitos visuais de plasma e fagulhas são apenas ilustrativos. Não conectar a motores nem plasma. Os ângulos de motor consideram redução ideal de 5:1, sem calibração, folga, limites ou homing físico. O botão de referenciamento é apenas ilustrativo.</p></section></main><script>
'use strict';const $=id=>document.getElementById(id),NS='http://www.w3.org/2000/svg',L=400,S=0.72,O={x:170,y:360};let pts=[],lens=[],total=0,dist=0,running=false,last=0,raf=0,valid=false,paths=[],rawPaths=[],usingDXF=false,segments=[],segmentIndex=0,segmentDist=0,torchOn=false,travelSpeed=3000;const v=(id)=>Number($(id).value);const xy=p=>({x:O.x+p.x*S,y:O.y-p.y*S});function node(name,attrs,parent){const el=document.createElementNS(NS,name);for(const [k,val] of Object.entries(attrs))el.setAttribute(k,val);parent.appendChild(el);return el}function ik(x,y){let r2=x*x+y*y,c=(r2-2*L*L)/(2*L*L);if(c>1+1e-8||c< -1-1e-8)return null;c=Math.max(-1,Math.min(1,c));let t2=v('elbow')*Math.acos(c),t1=Math.atan2(y,x)-Math.atan2(L*Math.sin(t2),L+L*Math.cos(t2));return {t1,t2,jx:L*Math.cos(t1),jy:L*Math.sin(t1)}}function arm(p){const k=ik(p.x,p.y);if(!k){$('state').textContent='Fora do alcance';return false}let b=xy({x:0,y:0}),j=xy({x:k.jx,y:k.jy}),t=xy(p);const angle1=Math.atan2(j.y-b.y,j.x-b.x)*180/Math.PI,angle2=Math.atan2(t.y-j.y,t.x-j.x)*180/Math.PI;$('arm1body').setAttribute('transform',`translate(${b.x} ${b.y}) rotate(${angle1})`);$('arm2body').setAttribute('transform',`translate(${j.x} ${j.y}) rotate(${angle2})`);$('baseassembly').setAttribute('transform',`translate(${b.x} ${b.y})`);$('jointassembly').setAttribute('transform',`translate(${j.x} ${j.y})`);$('torchassembly').setAttribute('transform',`translate(${t.x} ${t.y-24})`);$('sparks').setAttribute('transform',`translate(${t.x} ${t.y})`);$('pos').textContent=`${p.x.toFixed(1)} / ${p.y.toFixed(1)} mm`;$('angles').textContent=`${(k.t1*180/Math.PI).toFixed(1)}° / ${(k.t2*180/Math.PI).toFixed(1)}°`;$('motor1').textContent=(k.t1*180/Math.PI*5).toFixed(1)+'°';$('motor2').textContent=(k.t2*180/Math.PI*5).toFixed(1)+'°';return true}let visualFrame=0;function renderSparks(){const g=$('sparks');g.replaceChildren();if(!torchOn||!running)return;visualFrame++;node('circle',{cx:0,cy:0,r:6,fill:'#fff9cd',opacity:'.9'},g);for(let i=0;i<15;i++){let a=(i*2.39996+visualFrame*.39),r=6+((i*17+visualFrame*7)%24),x=Math.cos(a)*r,y=Math.sin(a)*r;node('line',{x1:x*.3,y1:y*.3,x2:x,y2:y,stroke:i%3?'#ff9d31':'#ffe9a5','stroke-width':i%4===0?2.5:1.5,'stroke-linecap':'round',opacity:.5+(i%4)*.12},g)}}function renderTrace(){const g=$('cuttrace');g.replaceChildren();for(let i=0;i<segments.length;i++){let s=segments[i];if(!s.cut||i>segmentIndex)continue;let end=i<segmentIndex?s.b:currentPoint();if(i===segmentIndex&&!running&&dist===0)continue;let a=xy(s.a),b=xy(end);node('line',{x1:a.x,y1:a.y,x2:b.x,y2:b.y,stroke:'#ffac54','stroke-width':3,'stroke-linecap':'round',opacity:'.95'},g)}}function torchSwitch(on){torchOn=on;$('torchstate').textContent=on?'🔥 LIGADA (SIMULAÇÃO)':'DESLIGADA';$('torchstate').style.color=on?'#ffaf50':'#a9ecff';$('torchglow').setAttribute('opacity',on?'.75':'0');$('torch').setAttribute('fill',on?'#fff3a0':'#e9b874');if(!on)$('sparks').replaceChildren()}function prepareSegments(){segments=[];let prev=null;let index=0;for(const path of paths){if(path.length<2)continue;index++;if(prev&&Math.hypot(path[0].x-prev.x,path[0].y-prev.y)>1e-7)segments.push({a:prev,b:path[0],cut:false,contour:index});for(let i=1;i<path.length;i++)segments.push({a:path[i-1],b:path[i],cut:true,contour:index});prev=path[path.length-1]}segmentIndex=0;segmentDist=0;dist=0;total=segments.reduce((sum,s)=>sum+Math.hypot(s.b.x-s.a.x,s.b.y-s.a.y),0);$('contourstate').textContent=`1 / ${index}`;torchSwitch(false);$('cuttrace').replaceChildren()}function currentPoint(){if(!segments.length)return pts[0];let s=segments[Math.min(segmentIndex,segments.length-1)],len=Math.hypot(s.b.x-s.a.x,s.b.y-s.a.y),t=Math.min(1,segmentDist/Math.max(len,1e-9));return {x:s.a.x+(s.b.x-s.a.x)*t,y:s.a.y+(s.b.y-s.a.y)*t}}function updateSimulation(){if(!segments.length)return;arm(currentPoint());renderTrace();renderSparks();let pct=total?100*dist/total:100;$('progress').value=pct;$('pct').textContent=pct.toFixed(1)+'%';$('contourstate').textContent=`${segments[Math.min(segmentIndex,segments.length-1)].contour} / ${paths.filter(p=>p.length>1).length}`}function setState(s){$('state').textContent=s}function stop(){running=false;cancelAnimationFrame(raf);last=0;torchSwitch(false)}function build(){usingDXF=false;stop();dist=0;pts=[];lens=[];total=0;let shape=$('shape').value,cx=v('cx'),cy=v('cy'),d=v('diam'),w=v('w'),h=v('h');if(![cx,cy,d,w,h].every(Number.isFinite)||d<=0||w<=0||h<=0){$('message').textContent='Informe medidas válidas.';valid=false;return}if(shape==='circle'){let n=Math.max(180,Math.ceil(Math.PI*d/2));for(let i=0;i<=n;i++){let a=2*Math.PI*i/n;pts.push({x:cx+d/2*Math.cos(a),y:cy+d/2*Math.sin(a)})}}else{let corners=[{x:cx-w/2,y:cy-h/2},{x:cx+w/2,y:cy-h/2},{x:cx+w/2,y:cy+h/2},{x:cx-w/2,y:cy+h/2},{x:cx-w/2,y:cy-h/2}];for(let k=0;k<4;k++){let a=corners[k],b=corners[k+1],n=Math.max(2,Math.ceil(Math.hypot(b.x-a.x,b.y-a.y)/2));for(let i=0;i<n;i++)pts.push({x:a.x+(b.x-a.x)*i/n,y:a.y+(b.y-a.y)*i/n})}pts.push(corners[4])}paths=[pts];prepareSegments();valid=pts.every(p=>ik(p.x,p.y)!==null);lens.push(0);for(let i=1;i<pts.length;i++){total+=Math.hypot(pts[i].x-pts[i-1].x,pts[i].y-pts[i-1].y);lens.push(total)}$('drawing').replaceChildren();$('labels').replaceChildren();$('cuttrace').replaceChildren();const pp=pts.map(p=>{let q=xy(p);return `${q.x},${q.y}`}).join(' ');node('polyline',{points:pp,stroke:valid?'#42d8ae':'#ff8c82','stroke-width':3,fill:'none'},$('drawing'));let origin=xy({x:0,y:0});node('circle',{cx:origin.x,cy:origin.y,r:4,fill:'#fff'},$('labels'));node('text',{x:origin.x+13,y:origin.y-13},$('labels')).textContent='Base (0,0)';$('message').textContent=valid?'Trajetória dentro do alcance geométrico. Limites mecânicos ainda não verificados.':'Trajetória fora do alcance de 800 mm. Ajuste a posição ou dimensões.';$('message').className=valid?'ok':'warn';$('progress').value=0;$('pct').textContent='0%';setState(valid?'Pronto':'Inválido');if(pts.length)arm(pts[0])}function atDistance(s){if(s<=0)return pts[0];if(s>=total)return pts[pts.length-1];let lo=0,hi=lens.length-1;while(lo<hi){let m=(lo+hi)>>1;if(lens[m]<s)lo=m+1;else hi=m}let i=lo,a=pts[Math.max(0,i-1)],b=pts[i],prev=i?lens[i-1]:0,t=(s-prev)/Math.max(1e-9,lens[i]-prev);return {x:a.x+(b.x-a.x)*t,y:a.y+(b.y-a.y)*t}}function render(){updateSimulation()}function tick(ts){if(!running)return;let dt=last?Math.min(100,ts-last)/60000:0;last=ts;let budget=dt;while(budget>0&&segmentIndex<segments.length){let s=segments[segmentIndex],len=Math.hypot(s.b.x-s.a.x,s.b.y-s.a.y),speed=s.cut?v('speed'):travelSpeed;if(!Number.isFinite(speed)||speed<=0){stop();setState('Velocidade inválida');return}torchSwitch(s.cut);let remain=len-segmentDist,step=Math.min(remain,budget*speed);segmentDist+=step;dist+=step;budget-=step/speed;if(segmentDist>=len-1e-7){segmentIndex++;segmentDist=0;if(segmentIndex<segments.length)torchSwitch(segments[segmentIndex].cut)}}if(segmentIndex>=segments.length){segmentIndex=segments.length-1;segmentDist=Math.hypot(segments[segmentIndex].b.x-segments[segmentIndex].a.x,segments[segmentIndex].b.y-segments[segmentIndex].a.y);dist=total;render();stop();setState('Concluído');return}render();raf=requestAnimationFrame(tick)}$('draw').onclick=build;$('start').onclick=()=>{if(!valid){build();if(!valid)return}if(!Number.isFinite(v('speed'))||v('speed')<=0){$('message').textContent='Velocidade precisa ser maior que zero.';return}if(dist>=total){segmentIndex=0;segmentDist=0;dist=0;}if(!running){running=true;last=0;setState('Simulando');raf=requestAnimationFrame(tick)}};$('pause').onclick=()=>{if(running){stop();setState('Pausado')}};$('stop').onclick=()=>{stop();segmentIndex=0;segmentDist=0;dist=0;render();setState('Parado')};$('home').onclick=()=>{stop();segmentIndex=0;segmentDist=0;dist=0;render();setState('Início')};$('elbow').onchange=()=>render();$('svg').onclick=()=>{if(!pts.length)return;const path=paths.map(contour=>contour.map((p,i)=>`${i?'L':'M'} ${p.x.toFixed(3)} ${(-p.y).toFixed(3)}`).join(' ')).join(' ');const data=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="-450 -450 900 900"><path d="${path}" fill="none" stroke="black" stroke-width="1"/></svg>`;const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([data],{type:'image/svg+xml'}));a.download='desenho-ms-cnc.svg';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};
function pairs(text){let a=text.replace(/\r/g,'').split('\n'),out=[];for(let i=0;i+1<a.length;i+=2){let code=Number(a[i].trim());if(Number.isFinite(code))out.push([code,a[i+1].trim()])}return out}
function entitiesDXF(text){let p=pairs(text),unit=4,raw=[],counts={},inEntities=false,entity=null,vertex=null,poly=null;
for(let i=0;i<p.length;i++){let [c,v]=p[i];if(c===9&&v==='$INSUNITS'){let j=i+1;while(j<p.length&&p[j][0]!==9&&p[j][0]!==0){if(p[j][0]===70)unit=Number(p[j][1]);j++}}}
function val(e,k,def=0){return Number((e?.fields||[]).find(z=>z[0]===k)?.[1]??def)}
function pointsArc(cx,cy,r,a,b){let delta=b-a;while(delta<0)delta+=Math.PI*2;let n=Math.max(8,Math.ceil(delta*r/2));return Array.from({length:n+1},(_,i)=>({x:cx+r*Math.cos(a+delta*i/n),y:cy+r*Math.sin(a+delta*i/n)}))}
function bulge(a,b,z){let chord=Math.hypot(b.x-a.x,b.y-a.y);if(!z||chord<1e-9)return [a,b];let theta=4*Math.atan(z),rad=chord/(2*Math.sin(Math.abs(theta)/2)),mx=(a.x+b.x)/2,my=(a.y+b.y)/2,off=chord/(2*Math.tan(theta/2)),nx=-(b.y-a.y)/chord,ny=(b.x-a.x)/chord,cx=mx+nx*off,cy=my+ny*off,start=Math.atan2(a.y-cy,a.x-cx),n=Math.max(8,Math.ceil(Math.abs(theta*rad)/2));return Array.from({length:n+1},(_,i)=>({x:cx+rad*Math.cos(start+theta*i/n),y:cy+rad*Math.sin(start+theta*i/n)}))}
function polyline(vs,closed){let result=[];if(vs.length<2)return;for(let k=0;k<vs.length-(closed?0:1);k++){let a=vs[k],b=vs[(k+1)%vs.length],seg=bulge(a,b,a.bulge||0);if(k)seg.shift();result.push(...seg)}raw.push(result)}
function flush(){if(!entity)return;let t=entity.type;counts[t]=(counts[t]||0)+1;let x=val(entity,10),y=val(entity,20),x2=val(entity,11),y2=val(entity,21),r=val(entity,40);if(t==='LINE')raw.push([{x,y},{x:x2,y:y2}]);if(t==='CIRCLE'&&r>0){let n=Math.max(80,Math.ceil(2*Math.PI*r/2));raw.push(Array.from({length:n+1},(_,i)=>({x:x+r*Math.cos(i*2*Math.PI/n),y:y+r*Math.sin(i*2*Math.PI/n)})))}if(t==='ARC'&&r>0)raw.push(pointsArc(x,y,r,val(entity,50)*Math.PI/180,val(entity,51)*Math.PI/180));if(t==='LWPOLYLINE'){let vs=[],vtx=null;for(const [k,z] of entity.fields){if(k===10){if(vtx)vs.push(vtx);vtx={x:Number(z),y:0,bulge:0}}else if(vtx&&k===20)vtx.y=Number(z);else if(vtx&&k===42)vtx.bulge=Number(z)}if(vtx)vs.push(vtx);polyline(vs,(val(entity,70)&1)!==0)}entity=null}
for(let i=0;i<p.length;i++){let [c,v]=p[i];if(c===0&&v==='SECTION'){if(p[i+1]?.[0]===2&&p[i+1]?.[1]==='ENTITIES')inEntities=true;continue}if(c===0&&v==='ENDSEC'){flush();inEntities=false;continue}if(!inEntities)continue;if(c===0){if(v==='VERTEX'&&poly){vertex={fields:[]};poly.verts.push(vertex);continue}if(v==='SEQEND'&&poly){polyline(poly.verts.map(z=>({x:val(z,10),y:val(z,20),bulge:val(z,42)})),(poly.flags&1)!==0);poly=null;continue}flush();if(v==='POLYLINE'){poly={verts:[],flags:0};entity={type:'POLYLINE',fields:[]};continue}if(v==='ENDSEC'||v==='EOF')continue;entity={type:v,fields:[]};continue}if(poly&&vertex){vertex.fields.push([c,v]);continue}if(entity){entity.fields.push([c,v]);if(entity.type==='POLYLINE'&&c===70)poly.flags=Number(v)}}flush();let mul=unit===1?25.4:unit===6?1000:1;return {raw,counts,mul,unit}}

// V4.2: conecta entidades DXF por extremidades, remove segmentos repetidos e otimiza deslocamentos.
function optimizeContours(input){
 const EPS=.08,near=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y)<=EPS;
 let edges=[];
 for(const path of input){for(let i=1;i<path.length;i++){
  const a=path[i-1],b=path[i];if(near(a,b))continue;
  // Deduplicar somente segmentos exatamente coincidentes, independentemente da direção.
  if(edges.some(e=>(near(e.a,a)&&near(e.b,b))||(near(e.a,b)&&near(e.b,a))))continue;
  edges.push({a,b,used:false});
 }}
 const degree=p=>edges.reduce((n,e)=>n+(near(e.a,p)?1:0)+(near(e.b,p)?1:0),0);
 const chains=[];
 while(edges.some(e=>!e.used)){
  const free=edges.filter(e=>!e.used);
  const candidates=free.flatMap(e=>[e.a,e.b]);
  let start=candidates.find(p=>degree(p)===1)||free[0].a;
  let chain=[start],cur=start,guard=0;
  while(guard++<edges.length+1){
   const matches=edges.filter(e=>!e.used&&(near(e.a,cur)||near(e.b,cur)));
   if(!matches.length)break;
   // Continuar em linha reta em junções quando possível, evitando saltos arbitrários.
   let chosen=matches[0];
   if(chain.length>1){const prev=chain[chain.length-2],vx=cur.x-prev.x,vy=cur.y-prev.y,vl=Math.hypot(vx,vy)||1;
    matches.sort((e,f)=>{const score=q=>{const z=near(q.a,cur)?q.b:q.a,wx=z.x-cur.x,wy=z.y-cur.y,wl=Math.hypot(wx,wy)||1;return (vx*wx+vy*wy)/(vl*wl)};return score(f)-score(e)});chosen=matches[0]}
   chosen.used=true;cur=near(chosen.a,cur)?chosen.b:chosen.a;chain.push(cur);
   if(near(cur,start))break;
  }
  if(chain.length>1)chains.push(chain);
 }
 // Primeiro contornos fechados; depois abertos. Próxima origem pelo menor deslocamento.
 const ordered=[],remaining=[...chains];let pos={x:0,y:0};
 while(remaining.length){let best=0,reverse=false,rotate=0,bestD=Infinity;
  remaining.forEach((c,i)=>{const closed=near(c[0],c[c.length-1]);const end=closed?c.length-1:c.length;
   for(let j=0;j<(closed?end:2);j++){let point=closed?c[j]:(j===0?c[0]:c[c.length-1]);let d=Math.hypot(point.x-pos.x,point.y-pos.y);
    if(d<bestD){bestD=d;best=i;rotate=closed?j:0;reverse=!closed&&j===1}}
  });
  let c=remaining.splice(best,1)[0];if(near(c[0],c[c.length-1])){let core=c.slice(0,-1);c=core.slice(rotate).concat(core.slice(0,rotate));c.push(c[0])}else if(reverse)c.reverse();
  ordered.push(c);pos=c[c.length-1];
 }
 return ordered;
}
function showImported(){if(!rawPaths.length)return;stop();dist=0;let mul=$('units').value==='auto'?importUnits:Number($('units').value);let source=rawPaths.map(path=>path.map(p=>({x:p.x*mul,y:p.y*mul})));let all=source.flat();let minx=Math.min(...all.map(p=>p.x)),maxx=Math.max(...all.map(p=>p.x)),miny=Math.min(...all.map(p=>p.y)),maxy=Math.max(...all.map(p=>p.y));let ox=v('dx')-(minx+maxx)/2,oy=v('dy')-(miny+maxy)/2;paths=source.map(path=>path.map(p=>({x:p.x+ox,y:p.y+oy})));paths=optimizeContours(paths);usingDXF=true;renderPaths()}
function renderPaths(){pts=[];lens=[];total=0;valid=true;$('drawing').replaceChildren();$('labels').replaceChildren();$('cuttrace').replaceChildren();let origin=xy({x:0,y:0});node('circle',{cx:origin.x,cy:origin.y,r:4,fill:'#fff'},$('labels'));node('text',{x:origin.x+13,y:origin.y-13},$('labels')).textContent='Base (0,0)';for(let path of paths){if(path.length<2)continue;let reachable=path.every(p=>ik(p.x,p.y)!==null);if(!reachable)valid=false;let pp=path.map(p=>{let q=xy(p);return q.x+','+q.y}).join(' ');node('polyline',{points:pp,stroke:reachable?'#42d8ae':'#ff8c82','stroke-width':3,fill:'none'},$('drawing'));for(let i=0;i<path.length;i++){if(i>0)total+=Math.hypot(path[i].x-path[i-1].x,path[i].y-path[i-1].y);pts.push(path[i]);lens.push(total)}}prepareSegments();if(!pts.length){valid=false;$('message').textContent='Nenhum contorno válido encontrado.';return} $('progress').value=0;$('pct').textContent='0%';$('message').textContent=valid?'DXF reorganizado por continuidade e proximidade. Contornos verdes dentro do alcance geométrico. Transições entre contornos são deslocamentos sem corte.':'Há trechos fora do alcance geométrico. Reposicione a peça.';$('message').className=valid?'ok':'warn';setState(valid?'Pronto':'Inválido');arm(pts[0])}
let importUnits=1;
$('import').onclick=async()=>{let f=$('dxf').files[0];if(!f){$('dxfinfo').textContent='Selecione um arquivo .dxf primeiro.';return}try{let data=entitiesDXF(await f.text());rawPaths=data.raw.filter(p=>p.length>1);importUnits=data.mul;if(!rawPaths.length)throw Error('Nenhuma entidade suportada encontrada. Exporte um esboço 2D em DXF.');let unsupported=Object.entries(data.counts).filter(([k])=>!['LINE','CIRCLE','ARC','LWPOLYLINE','POLYLINE','VERTEX','SEQEND'].includes(k)).map(([k,n])=>k+': '+n);$('dxfinfo').textContent=`${f.name} · ${rawPaths.length} contorno(s) · unidade DXF ${data.unit} · ${unsupported.length?'Ignoradas: '+unsupported.join(', '):'Sem entidades desconhecidas detectadas'}`;showImported()}catch(e){$('dxfinfo').textContent='Erro ao importar: '+e.message}};
